    title: PyMAPF
    authors:
      - family-names: Lejeune
        given-names: Erwin
      - family-names: Sarkar
        given-names: Sampreet
    repository-code: "https://github.com/openplan-labs/pymapf"
    url: "https://openplan-labs.github.io/pymapf/"
    version: 0.9.0
